# Copy to .env and adjust for your local setup.
APP_ENV=development
API_PREFIX=/api
# Timestamps are stored in UTC; calendar days ("today", dose dates) use this zone.
APP_TIMEZONE=Asia/Kolkata

# Postgres (these must match docker-compose.yml)
POSTGRES_USER=phia
POSTGRES_PASSWORD=phia
POSTGRES_DB=phia
DATABASE_URL=postgresql+psycopg://phia:phia@localhost:5432/phia
# Windows without Docker: portable Postgres folder (holds pgsql\ and data\) that
# scripts/dev.py starts for you. Leave empty when using docker compose.
# LOCAL_PG_HOME=C:\Users\<you>\AppData\Local\phia-postgres

# ChromaDB. "embedded" (local default) = in-process, persisted at CHROMA_PATH
# (relative to backend/). Stop the backend before running seed/reset scripts: two
# processes must not write the same embedded store at once.
# "http" = a separate Chroma server at CHROMA_HOST:CHROMA_PORT.
CHROMA_MODE=embedded
CHROMA_PATH=chroma_data
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# Auth (override SECRET_KEY outside local dev; keep >=32 chars)
SECRET_KEY=dev-only-change-me-in-prod-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Uploaded lab report files
UPLOAD_DIR=uploads

# Memory Agent retrieval
MEMORY_TOPK=5
RECENT_WINDOW_DAYS=180

# Reasoning constants
RESOLVE_AFTER_DAYS=90
CLUSTER_WINDOW_HOURS=48
MISSING_BP_DAYS=60

# ---- LLM: every call goes through app/core/llm.py (memory.md D15) ----
# All optional: with no keys the app runs on deterministic offline fallbacks.
# Primary: your LiteLLM proxy (OpenAI-compatible). List the exact model names it
# exposes with `uv run python -m scripts.llm_smoke_test --list-models`.
LLM_BASE_URL=
LLM_API_KEY=
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-sonnet-5-5
MODEL_VISION=claude-sonnet-5-5
# Fallback when the proxy is down or unset, plus Whisper speech-to-text: Groq
# (free key at https://console.groq.com/). The v1 name GROQ_API_KEY also works.
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_MODEL=openai/gpt-oss-120b
FALLBACK_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
STT_MODEL=whisper-large-v3-turbo
# One JSON line per LLM call (task, model, tokens, estimated cost; never prompt text).
# Leave empty to turn it off.
LLM_USAGE_LOG=llm_usage.jsonl
# Optional: openFDA key (higher rate limits, Phase 5) and the unverified
# "AI flag" level for medication findings (Phase 5; false = sourced-only).
OPENFDA_API_KEY=
MED_AI_FLAGS_ENABLED=false
