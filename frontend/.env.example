# Base URL the frontend uses for API calls. Baked in at BUILD time by Vite.
#
# Local dev: "/api" (Vite proxies to the backend).
# Production (Vercel): the full backend URL INCLUDING the /api prefix, e.g.
#   VITE_API_BASE=https://phia-backend.onrender.com/api
#
# Changing this in Vercel requires a redeploy for the new value to take effect.
VITE_API_BASE=/api
