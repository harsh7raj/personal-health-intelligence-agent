# Copy to .env and adjust for your local setup.
APP_ENV=development
API_PREFIX=/api

# Postgres (these must match docker-compose.yml)
POSTGRES_USER=phia
POSTGRES_PASSWORD=phia
POSTGRES_DB=phia
DATABASE_URL=postgresql+psycopg://phia:phia@localhost:5432/phia

# ChromaDB (server container)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Auth (override SECRET_KEY outside local dev)
SECRET_KEY=dev-only-change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Uploaded lab report files
UPLOAD_DIR=uploads

# Intake LLM — Groq (free tier, OpenAI-compatible). Add your key here.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
INTAKE_MODEL=llama-3.3-70b-versatile

# Memory Agent retrieval
MEMORY_TOPK=5
RECENT_WINDOW_DAYS=180

# Reasoning + Response LLM (Groq)
REASONING_MODEL=llama-3.3-70b-versatile
RESPONSE_MODEL=llama-3.3-70b-versatile

# Reasoning constants
RESOLVE_AFTER_DAYS=90
CLUSTER_WINDOW_HOURS=48
MISSING_BP_DAYS=60
